@@ -0,0 +1,56 @@
+name: Build and deploy FastAPI AI to Azure Web App - tourdulich-ai
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [develop]
+    paths:
+      - "ai-service/**"
+      - ".github/workflows/deploy-ai-service.yml"
+
+jobs:
+  docker:
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      packages: write
+      id-token: write
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Log in to GitHub Container Registry
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push image
+        uses: docker/build-push-action@v6
+        with:
+          context: ./ai-service
+          push: true
+          tags: ghcr.io/${{ github.repository_owner }}/tourdulich-ai:latest
+
+      - name: Login to Azure
+        uses: azure/login@v2
+        with:
+          client-id: ${{ secrets.AZUREAPPSERVICE_CLIENTID_4C3396D416D94CC2B0047D7A68E3B21F }}
+          tenant-id: ${{ secrets.AZUREAPPSERVICE_TENANTID_AED639D6C02E48D796FA641688F97959 }}
+          subscription-id: ${{ secrets.AZUREAPPSERVICE_SUBSCRIPTIONID_F04778F9E57849F39E0E2BA253410673 }}
+
+      - name: Point Web App to the image
+        run: |
+          RG=$(az webapp list --query "[?name=='tourdulich-ai'].resourceGroup" -o tsv)
+          if [ -z "$RG" ]; then
+            echo "Chưa có Web App tên tourdulich-ai. Tạo app trên Azure rồi chạy lại workflow này."
+            exit 0
+          fi
+          az webapp config container set \
+            --name tourdulich-ai \
+            --resource-group "$RG" \
+            --docker-custom-image-name ghcr.io/${{ github.repository_owner }}/tourdulich-ai:latest \
+            --docker-registry-server-url https://ghcr.io
+          az webapp config appsettings set --name tourdulich-ai --resource-group "$RG" \
+            --settings WEBSITES_PORT=8000 WEBSITES_CONTAINER_START_TIME_LIMIT=180
+          az webapp restart --name tourdulich-ai --resource-group "$RG"
