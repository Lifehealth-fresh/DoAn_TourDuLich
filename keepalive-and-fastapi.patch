+name: Keep-alive API SQL and AI
+
+on:
+  schedule:
+    - cron: "*/10 * * * *"
+  workflow_dispatch:
+
+jobs:
+  ping:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Wake ASP.NET API and Azure SQL
+        run: |
+          set -e
+          for i in 1 2 3; do
+            if curl -fsS --max-time 90 "https://tourdulich-api-bvguh6guhka7dbh0.eastasia-01.azurewebsites.net/api/health"; then
+              echo
+              exit 0
+            fi
+            echo "retry $i"
+            sleep 15
+          done
+          echo "API health failed"
+          exit 1
+
+      - name: Wake FastAPI AI
+        continue-on-error: true
+        run: |
+          curl -fsS --max-time 90 "https://tourdulich-ai.azurewebsites.net/health" || echo "AI not hosted yet"
